ture auxiliaries wollen (“will”) and sollen (“shall”). The last two have been displaced by werden in Modern German but survive dialectally (as future auxiliaries).","etymology_links":[["wërden","werden#Middle_High_German"],["wërdan","werdan#Old_High_German"],["*werþan","Reconstruction:Proto-West Germanic/werþan"],["*werþaną","Reconstruction:Proto-Germanic/werþaną"],["worden","worden#Dutch"],["worth","worth#Etymology_2"],["varda","varda#Swedish"],["verta","verta#Norwegian_Nynorsk"],["vertō","verto#Latin"],["inchoative","inchoative"],["wollen","wollen#German"],["sollen","sollen#German"]],"etymology_templates":[{"name":"inh","args":{"1":"de","2":"gmh","3":"wërden"},"expansion":"Middle High German wërden"},{"name":"inh","args":{"1":"de","2":"goh","3":"wërdan"},"expansion":"Old High German wërdan"},{"name":"inh","args":{"1":"de","2":"gmw-pro","3":"*werþan"},"expansion":"Proto-West Germanic *werþan"},{"name":"inh","args":{"1":"de","2":"gem-pro","3":"*werþaną"},"expansion":"Proto-Germanic *werþaną"},{"name":"cog","args":{"1":"nl","2":"worden"},"expansion":"Dutch worden"},{"name":"cog","args":{"1":"en","2":"worth#Etymology_2"},"expansion":"English worth"},{"name":"cog","args":{"1":"sv","2":"varda"},"expansion":"Swedish varda"},{"name":"cog","args":{"1":"nn","2":"verta"},"expansion":"Norwegian Nynorsk verta"},{"name":"cog","args":{"1":"la","2":"vertō","3":"","4":"to turn"},"expansion":"Latin vertō (“to turn”)"}],"sounds":[{"ipa":"/ˈveːʁdən/"},{"ipa":"[ˈveːɐ̯.dn̩]"},{"ipa":"[ˈvɛɐ̯-]"},{"ipa":"[ʋ-]"},{"ipa":"[-dən]"},{"audio":"De-werden.ogg","ogg_url":"https://upload.wikimedia.org/wikipedia/commons/b/b4/De-werden.ogg","mp3_url":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b4/De-werden.ogg/De-werden.ogg.mp3"},{"audio":"De-werden3.ogg","tags":["Germany","Berlin"],"ogg_url":"https://upload.wikimedia.org/wikipedia/commons/c/c1/De-werden3.ogg","mp3_url":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c1/De-werden3.ogg/De-werden3.ogg.mp3"}],"word":"werde