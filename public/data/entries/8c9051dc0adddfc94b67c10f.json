ündigung – zu vergleichsweise niedrigeren Abfindungszahlungen führt.","ref":"2023 July 31, Julius Siegel, “Der Chefarzt als Führungskraft: Ist er noch Arbeitnehmer oder schon leitender Angestellter?”, in Medizinrecht, volume 41, number 8, →DOI, page 641:","type":"quotation","bold_text_offsets":[[233,242]]}],"categories":["German terms with quotations","German terms with rare senses","Requests for translations of German quotations"],"links":[["examine","examine"]],"synonyms":[{"word":"prüfen"},{"word":"untersuchen"}],"raw_glosses":["(now rare) to examine"],"glosses":["to examine"],"tags":["archaic","weak"]}],"pos":"verb","head_templates":[{"name":"de-verb","args":{},"expansion":"versuchen (weak, third-person singular present versucht, past tense versuchte, past participle versucht, auxiliary haben)"}],"categories":["German entries with incorrect language header","German lemmas","German terms prefixed with ver-","German verbs","German verbs using haben as auxiliary","German weak verbs","Pages with 1 entry","Pages with entries"],"forms":[{"form":"versucht","tags":["present","singular","third-person"]},{"form":"versuchte","tags":["past"]},{"form":"versucht","tags":["participle","past"]},{"form":"haben","tags":["auxiliary"]},{"form":"weak","source":"conjugation","tags":["table-tags"]},{"form":"de-conj","source":"conjugation","tags":["inflection-template"]},{"form":"haben","source":"conjugation","tags":["auxiliary"]},{"form":"versuchen","tags":["infinitive"],"source":"conjugation"},{"form":"versuchend","tags":["participle","present"],"source":"conjugation"},{"form":"versucht","tags":["participle","past"],"source":"conjugation"},{"form":"versuche","tags":["first-person","indicative","present","singular"],"source":"conjugation"},{"form":"versuchen","tags":["first-person","indicative","plural","present"],"source":"conjugation"},{"form":"versuche","tags":["first-person","singular","subjunctive","subjunctive-i"],"source":"conjugation"},{"form":"versuchen","tags":["first-person